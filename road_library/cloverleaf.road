road exit_ramp:
    verge carlane verge;
    direction forward;
    role ramp;
end

road interstate_three_lane:
    verge carlane carlane carlane middle carlane carlane carlane verge;
end

road interstate_core:
    carlane carlane carlane middle carlane carlane carlane;
end

road ramp_mouth:
    carlane;
    direction forward;
    role merge;
end

