# Canonical visual QA specimens corresponding to the standalone procedural prototype.
# 0.01 map units per specimen meter; the lot includes canopy/cornice projections.
# Height reserves four specimen meters for cornices and rooftop services.
# Width/depth of each primary shell, upper-floor count, palettes and glass tints match.
qa_ground = concrete(-10,-10, 22,-10, 22,12, -10,12);
elevation(qa_ground,0.02);
