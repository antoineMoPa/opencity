intersection crossroads {
    # External lane anchors and travel headings
    port N {
        in  at (-3, -20) heading south;
        out at ( 3, -20) heading north;
    }
    port S {
        in  at ( 3,  20) heading north;
        out at (-3,  20) heading south;
    }
    port E {
        in  at ( 20, -3) heading west;
        out at ( 20,  3) heading east;
    }
    port W {
        in  at (-20,  3) heading east;
        out at (-20, -3) heading west;
    }

    # North approach: through, right, left
    path N_S { from N.in; line to S.out; }
    path N_W {
        from N.in;
        cubic (-3, -8), (-8, -3) to W.out;
    }
    path N_E {
        from N.in;
        cubic (-3, 4), (7, 3) to E.out;
    }

    # South approach
    path S_N { from S.in; line to N.out; }
    path S_E {
        from S.in;
        cubic (3, 8), (8, 3) to E.out;
    }
    path S_W {
        from S.in;
        cubic (3, -4), (-7, -3) to W.out;
    }

    # East approach
    path E_W { from E.in; line to W.out; }
    path E_N {
        from E.in;
        cubic (8, -3), (3, -8) to N.out;
    }
    path E_S {
        from E.in;
        cubic (-4, -3), (-3, 8) to S.out;
    }

    # West approach
    path W_E { from W.in; line to E.out; }
    path W_N {
        from W.in;
        cubic (4, 3), (3, -8) to N.out;
    }
    path W_S {
        from W.in;
        cubic (-8, 3), (-3, 8) to S.out;
    }

    # Explicitly authorize each vehicle trajectory
    allow vehicle N.in -> S.out via N_S;
    allow vehicle N.in -> W.out via N_W;
    allow vehicle N.in -> E.out via N_E;
    allow vehicle S.in -> N.out via S_N;
    allow vehicle S.in -> E.out via S_E;
    allow vehicle S.in -> W.out via S_W;
    allow vehicle E.in -> W.out via E_W;
    allow vehicle E.in -> N.out via E_N;
    allow vehicle E.in -> S.out via E_S;
    allow vehicle W.in -> E.out via W_E;
    allow vehicle W.in -> N.out via W_N;
    allow vehicle W.in -> S.out via W_S;

    surface north_south_pavement along N_S width 12;
    surface east_west_pavement along E_W width 12;

    # Rounded northwest sidewalk / curb boundary
    path curb_NW {
        move (-20, -9);
        line (-13, -9);
        arc to (-9, -13) radius 4;
        line (-9, -20);
    }
    surface sidewalk_NW along curb_NW width 3 side left material sidewalk;

    # Road paint is also geometric
    path north_stop {
        move (-6, -12);
        line (0, -12);
    }
    marking stop_N along north_stop width 0.3 color white;

    # NE / SE / SW curb paths, other sidewalks, pavement
    # surfaces, and remaining stop lines follow the same DSL.
}


interchange highway_junction {
    port W.in  at (-100, 0, 0) heading east;
    port E.out at ( 100, 0, 0) heading east;
    port N.out at (  30, -100, 8) heading north;

    path highway {
        from W.in;
        line to E.out;
    }

    anchor exit at highway distance 65;

    path exit_ramp {
        from exit;
        cubic (-10, 0, 1), (30, -40, 8) to N.out;
    }

    # Graph links can reference a shared mainline prefix
    allow vehicle W.in -> E.out via highway;
    allow vehicle W.in -> N.out via highway[0..exit]
                                 then exit_ramp;

    surface main_pavement along highway width 7;
    surface exit_pavement along exit_ramp width 4;

    # An overpass crossing is NOT automatically a junction.
    # A merge requires an explicit 'join' anchor + connectivity.
}


road_segment merge_section {
    port A.in  at (-80, 0, 0) heading east;
    port B.out at ( 80, 0, 0) heading east;
    port R.in  at (0, 45, 0) heading north;

    path mainline {
        from A.in;
        line to B.out;
    }

    anchor merge_point at mainline distance 100;

    path on_ramp {
        from R.in;
        cubic (0, 20, 0), (15, 0, 0) to merge_point;
    }

    allow vehicle A.in -> B.out via mainline;
    allow vehicle R.in -> B.out via on_ramp
                                 then mainline[merge_point..end];
}

cross = crossroads(0, 0);
highway = highway_junction(300, 0);
merge = merge_section(600, 0);
