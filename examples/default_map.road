elevation(st_village_south, 0.105);
elevation(st_harbor_street, 0.105);

# Each enclosed town block contains exactly 3 x 3 independently editable buildings.
# Facade seed 0xFACAD3: more glass downtown, more brick around the outskirts.
# Footprint seed 0x0C172026; city centers are the mean centers of enclosed blocks.
# Stories = weighted_random(1..4) + round(6 * half_cosine(distance/(0.45*radius))^2).
# Half-cosine = (1+cos(PI*min(distance/core_radius,1)))/2; heights are complete stories.
