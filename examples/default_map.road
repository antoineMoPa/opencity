elevation(nt_freeway_terminal, 0.105);
elevation(nt_village_west, 0.105);
elevation(nt_village_east, 0.105);

# A coast road crosses the southern strait and ends at the island's flat western edge.
st_mainland_coast = map_point(-13.8, -4.95);
st_span_start = map_point(-13.8, -7.2);
st_span_bend = map_point(-10.8, -10.05);
