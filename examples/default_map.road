# East town diamond: four explicit outer-lane ramps and a street overpass.
road east_access_ramp: verge carlane verge; direction forward; role ramp; end
road east_access_stub: verge carlane verge; direction forward; end
road east_access_merge: verge carlane verge; direction forward; role merge; end

east_highway_west=map_point(13.8, 7.2);
east_highway_east=map_point(27, 7.2);
