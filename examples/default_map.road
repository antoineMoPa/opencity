road exit_ramp:
    verge carlane verge;
    direction forward;
    role ramp;
end

road interstate_three_lane:
    verge carlane carlane carlane middle carlane carlane carlane verge;
    role highway;
end

road interstate_core:
    verge carlane carlane carlane middle carlane carlane carlane verge;
    role highway;
end

road ramp_mouth:
    verge carlane verge;
    direction forward;
    role merge;
end

