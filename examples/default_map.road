# Road network: local patches have explicit edge ports and continuous grades.
road town_street:
    sidewalk carlane middle carlane sidewalk;
end

# Reusable road-profile junctions. Local +Y is north; rotate the canonical layout
# counterclockwise in degrees. min/max are signed footprint offsets from center.
intersection town_corner({ profile, min, max }: { profile: identifier, min: number, max: number }) {
    center = map_point(0, 0);
    north = map_point(0, max);
    east = map_point(max, 0);
    intersection2(center, profile, north, north, east, east);
}
intersection town_three_way({ profile, min, max }: { profile: identifier, min: number, max: number }) {
    center = map_point(0, 0);
    north = map_point(0, max);
    east = map_point(max, 0);
    west = map_point(min, 0);
    intersection3(center, profile, north, north, east, east, west, west);
}
intersection town_four_way({ profile, min, max }: { profile: identifier, min: number, max: number }) {
    center = map_point(0, 0);
    north = map_point(0, max);
    east = map_point(max, 0);
    south = map_point(0, min);
    west = map_point(min, 0);
    intersection4(center, profile, north, north, east, east, south, south, west, west);
}

