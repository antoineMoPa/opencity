# The freeway becomes a harbor access boulevard at a mixed-profile T.
# Shared west_highway_terminal and west_harbor_terminal are parent-owned.
wt_highway_bend = map_point(-31.95, 6);
wt_harbor_west = map_point(-33, 3.6);
wt_harbor_bend = map_point(-32.7, 2.1);
wt_center = town_three_way(-31.95, 3.6, 0, 90, { profile: town_street, min: -0.1825, max: 0.1825 });
wt_freeway_curve = interstate_three_lane(wt_highway_bend, -31.95, 6.75, -31.8, 7.2, west_highway_terminal);
wt_freeway_terminal = interstate_three_lane(wt_center.east, -31.95, 4.3525, -31.95, 5.43, wt_highway_bend);
wt_harbor_spur = town_street(wt_harbor_west, -32.88, 3.6, -32.2525, 3.6, wt_center.north);
wt_harbor_approach = town_street(wt_center.west, -31.95, 3.0575, -32.7, 2.55, wt_harbor_bend);
wt_harbor_return = town_street(wt_harbor_bend, -32.7, 1.5, -32.4, 1.5, west_harbor_terminal);
elevation(wt_center.center, 0.105);
elevation(wt_freeway_curve, 0.105);
elevation(wt_freeway_terminal, 0.105);
elevation(wt_harbor_spur, 0.105);
elevation(wt_harbor_approach, 0.105);
elevation(wt_harbor_return, 0.105);

# Eastern highway skirts the ridge on its west side, then follows the northeast plain.
east_coast_bend=map_point(28.05, 8.4);
east_coast_ridge_end=map_point(28.05, 10.5);
